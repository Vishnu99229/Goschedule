# Local env (copy to .env.local — never commit real keys)

# ElevenLabs Conversational AI (server-only — set in Vercel for production)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional: seconds between voice sessions per visitor (default 120)
# VOICE_COOLDOWN_SECONDS=120

# Optional: post-call webhook (n8n or similar)
# N8N_VOICE_WEBHOOK_URL=

# Optional: override voice provider on the client (elevenlabs | vapi | retell)
# VITE_VOICE_PROVIDER=elevenlabs
