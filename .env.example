# Local env (copy to .env.local — never commit real keys)

# ElevenLabs Conversational AI (server-only — set in Vercel for production)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional: seconds between voice sessions per visitor (default 120)
# VOICE_COOLDOWN_SECONDS=120

# Optional: post-call lead webhook (n8n) — server only; skipped when unset
# N8N_WEBHOOK_URL=

# ElevenLabs post-call webhook HMAC secret (workspace webhook settings)
# ELEVENLABS_WEBHOOK_SECRET=

# Legacy alias for N8N_WEBHOOK_URL
# N8N_VOICE_WEBHOOK_URL=

# Voice provider on the client: mock (default) | elevenlabs | vapi | retell
# VITE_VOICE_PROVIDER=mock
